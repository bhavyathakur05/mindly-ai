# Copy to .env.local and restart `npm run dev`.
# Server-side only - never prefixed with NEXT_PUBLIC_.
   AI_API_KEY=your-gemini-key-here
# Optional: model used for all tiers
AI_MODEL = gemini-3.5-flash-lite
# Optional per-tier overrides (Mindly Fast / Smart / Reasoning)
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_SMART=claude-sonnet-5-5
# AI_MODEL_REASONING=claude-opus-5-5
